# --- Speech (required) ---
# Intron Sahara v2.5 — https://voice.intron.io  (Developers tab)
INTRON_API_KEY=

# --- Hugging Face (required for AfriSwitch, which is manually gated) ---
# https://huggingface.co/settings/tokens  (a `read` token is enough)
HF_TOKEN=

# --- LLM for the case compiler (ANY ONE of these) ---
# The compiler auto-detects whichever is set, in this order of preference.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=

# Optional override: force a provider/model instead of auto-detect
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
